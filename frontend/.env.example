# Frontend Environment Variables Template
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_NAME="FloodShield AI"
# AWS Open Data Terrain Tiles in Terrarium format; replace with another raster-dem provider if needed.
NEXT_PUBLIC_DEM_TILE_URL="https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
NEXT_PUBLIC_TERRAIN_EXAGGERATION="1.25"
# Optional licensed live traffic vector tiles. The provider must expose a `traffic` source layer
# with a `congestion` property containing severe, heavy, moderate, or free-flow values.
NEXT_PUBLIC_TRAFFIC_TILE_URL=""
NEXT_PUBLIC_TRAFFIC_SOURCE_LAYER="traffic"
NEXT_PUBLIC_TRAFFIC_ATTRIBUTION=""
