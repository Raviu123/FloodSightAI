PROJECT_NAME="FloodShield AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey-for-development-change-in-production"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS origins (comma-separated or JSON list)
